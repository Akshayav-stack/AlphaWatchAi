# ==============================================================================
# AlphaWatch AI - Unified Environment Configuration (3-Tier Architecture)
# ASTRAQUANT X 2026 - Problem Statement 16
# ==============================================================================

# Application Environment: 'development' | 'production'
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Node.js Express Public Gateway Server
# ------------------------------------------------------------------------------
PORT=5000
CLIENT_URL=http://127.0.0.1:3000
SESSION_SECRET=alphawatch-super-secret-session-cookie-key-min-32-chars-hex
CSRF_SECRET=alphawatch-super-secret-csrf-token-key-min-32-chars-hex
DATABASE_PATH=./alphawatch_users.db
COOKIE_SECURE=false

# Rate Limiting & Lockout Policy
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=3
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
MIN_PASSWORD_LENGTH=10

# Internal ML Microservice Loopback Address
ML_SERVICE_URL=http://127.0.0.1:8001

# ------------------------------------------------------------------------------
# 2. Python FastAPI Internal ML Microservice
# ------------------------------------------------------------------------------
ML_HOST=127.0.0.1
ML_PORT=8001

# ------------------------------------------------------------------------------
# 3. React Frontend Client
# ------------------------------------------------------------------------------
VITE_API_URL=/api
